{
  "name": "showup",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first event tracker: capture by voice, screenshot or text; never miss a registered event.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "TZ=Europe/London node --test \"test/unit/*.test.js\"",
    "test:e2e": "TZ=Europe/London node --test --test-concurrency=1 \"test/e2e/*.test.js\"",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs dist 4173",
    "icons": "node scripts/make-icons.mjs"
  }
}
